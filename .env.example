# DeepSeek API 密钥（AI 教练复盘与练习计划）
DEEPSEEK_API_KEY=

# ===== 识谱视觉模型（三选一，改 VISION_PROVIDER + 对应 Key）=====
# 智谱（免费，读谱差，保底）：VISION_PROVIDER=zhipu + ZHIPU_API_KEY + VITE_VISION_MODEL=glm-4v-flash
# Google Gemini（读谱最强，需代理）：VISION_PROVIDER=gemini + GEMINI_API_KEY + VITE_VISION_MODEL=gemini-2.5-flash
# 阿里通义（国内直连）：VISION_PROVIDER=dashscope + DASHSCOPE_API_KEY + VITE_VISION_MODEL=qwen-vl-max
VISION_PROVIDER=zhipu
VITE_VISION_MODEL=glm-4v-flash
ZHIPU_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=

# Gemini 走本机代理地址（默认 127.0.0.1:7892，关闭代理转发设 GEMINI_PROXY=off）
# GEMINI_PROXY=off
